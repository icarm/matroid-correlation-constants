{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matroid Correlation Constants concrete-matroid submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "proposed_name",
    "contributors",
    "ground_set",
    "input",
    "claimed_alpha_bar",
    "discovery",
    "submitted_at",
    "provenance",
    "license"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "matroid" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "proposed_name": { "type": "string", "minLength": 1 },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contributor" }
    },
    "ground_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels"],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/label" }
        }
      }
    },
    "input": {
      "oneOf": [
        { "$ref": "#/$defs/matrixInput" },
        { "$ref": "#/$defs/basesInput" },
        { "$ref": "#/$defs/circuitsInput" },
        { "$ref": "#/$defs/hyperplanesInput" }
      ]
    },
    "representations": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/matrixCertificate" }
    },
    "claimed_alpha_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "claimed_maximizing_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/label" }
    },
    "discovery": { "$ref": "#/$defs/discovery" },
    "submitted_at": { "type": "string", "minLength": 1 },
    "provenance": { "type": "string", "minLength": 1 },
    "citation": { "type": "string" },
    "license": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "$defs": {
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "discoverers",
        "ai_used",
        "ai_model_version",
        "ai_role"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$"
        },
        "discoverers": { "type": "string", "minLength": 1 },
        "ai_used": { "type": "boolean" },
        "ai_model_version": { "type": "string", "minLength": 1 },
        "ai_role": { "type": "string", "minLength": 1 },
        "ai_chat_url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "label": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "github": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["order"],
          "properties": {
            "kind": { "const": "finite" },
            "order": { "type": "integer", "minimum": 2 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "rational" }
          }
        }
      ]
    },
    "matrixCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "type": { "const": "matrix" },
        "rank": { "type": "integer", "minimum": 1 },
        "field": { "$ref": "#/$defs/field" },
        "rows": { "$ref": "#/$defs/fieldMatrix" },
        "columns": { "$ref": "#/$defs/fieldMatrix" }
      },
      "oneOf": [
        { "required": ["rows"] },
        { "required": ["columns"] }
      ]
    },
    "matrixInput": {
      "allOf": [
        { "$ref": "#/$defs/matrixCertificate" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "matrix" } }
        }
      ]
    },
    "fieldEntry": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$" },
        {
          "type": "array",
          "minItems": 2,
          "items": { "type": "integer" }
        }
      ]
    },
    "fieldMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/fieldEntry" }
      }
    },
    "setList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "array",
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/label" }
      }
    },
    "basesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sets"],
      "properties": {
        "type": { "const": "bases" },
        "rank": { "type": "integer", "minimum": 1 },
        "sets": { "$ref": "#/$defs/setList" }
      }
    },
    "circuitsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sets"],
      "properties": {
        "type": { "const": "circuits" },
        "rank": { "type": "integer", "minimum": 1 },
        "sets": { "$ref": "#/$defs/setList" }
      }
    },
    "hyperplanesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sets"],
      "properties": {
        "type": { "const": "hyperplanes" },
        "rank": { "type": "integer", "minimum": 1 },
        "sets": { "$ref": "#/$defs/setList" }
      }
    }
  }
}
